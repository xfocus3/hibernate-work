+package org.hibernate.orm.test.query.sql;
+
+import java.io.Serializable;
+import java.util.List;
+import java.util.Objects;
+
+import org.hibernate.testing.orm.junit.DomainModel;
+import org.hibernate.testing.orm.junit.JiraKey;
+import org.hibernate.testing.orm.junit.SessionFactory;
+import org.hibernate.testing.orm.junit.SessionFactoryScope;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Embeddable;
+import jakarta.persistence.EmbeddedId;
+import jakarta.persistence.Entity;
+import jakarta.persistence.Table;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+@DomainModel(annotatedClasses = EmbeddedIdAliasInjectionTest.DummyEntity.class)
+@SessionFactory
+@JiraKey("HHH-20388")
+class EmbeddedIdAliasInjectionTest {
+	@BeforeAll
+	void setUp(SessionFactoryScope scope) {
+		scope.inTransaction( session -> {
+			final var entity = new DummyEntity();
+			entity.id = new DummyId( 1L, 2L );
+			entity.field1 = "first value";
+			entity.field2 = "second value";
+			session.persist( entity );
+		} );
+	}
+
+	@Test
+	void untypedAliasInjection(SessionFactoryScope scope) {
+		scope.inTransaction( session -> assertResult( session.createNativeQuery(
+				"SELECT {e.*} FROM DUMMY_TABLE e WHERE e.ID1 = 1" )
+				.addEntity( "e", DummyEntity.class ).getResultList() ) );
+	}
+
+	@Test
+	void typedAliasInjection(SessionFactoryScope scope) {
+		scope.inTransaction( session -> assertResult( session.createNativeQuery(
+				"SELECT {e.*} FROM DUMMY_TABLE e WHERE e.ID1 = 1", DummyEntity.class, "e" )
+				.getResultList() ) );
+	}
+
+	@Test
+	void plainSelectControl(SessionFactoryScope scope) {
+		scope.inTransaction( session -> assertResult( session.createNativeQuery(
+				"SELECT e.* FROM DUMMY_TABLE e WHERE e.ID1 = 1", DummyEntity.class )
+				.getResultList() ) );
+	}
+
+	private static void assertResult(List<?> results) {
+		assertEquals( 1, results.size() );
+		final var entity = (DummyEntity) results.get( 0 );
+		assertEquals( 1L, entity.id.id1 );
+		assertEquals( 2L, entity.id.id2 );
+		assertEquals( "first value", entity.field1 );
+		assertEquals( "second value", entity.field2 );
+	}
+
+	@Entity(name = "DummyEntity")
+	@Table(name = "DUMMY_TABLE")
+	static class DummyEntity {
+		@EmbeddedId
+		private DummyId id;
+		@Column(name = "FIELD1")
+		private String field1;
+		@Column(name = "FIELD2")
+		private String field2;
+	}
+
+	@Embeddable
+	static class DummyId implements Serializable {
+		@Column(name = "ID1")
+		private Long id1;
+		@Column(name = "ID2")
+		private Long id2;
+
+		DummyId() {
+		}
+
+		DummyId(Long id1, Long id2) {
+			this.id1 = id1;
+			this.id2 = id2;
+		}
+
+		@Override
+		public boolean equals(Object object) {
+			return object instanceof DummyId other
+					&& Objects.equals( id1, other.id1 ) && Objects.equals( id2, other.id2 );
+		}
+
+		@Override
+		public int hashCode() {
+			return Objects.hash( id1, id2 );
+		}
+	}
+}
