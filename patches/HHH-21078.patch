+	private void completeRestrictedToOneGrouping(SqmQuerySpec<?> sqmQuerySpec, QuerySpec sqlQuerySpec) {
+		if ( sqlQuerySpec.getGroupByClauseExpressions().isEmpty()
+				|| domainResults == null || domainResults.size() != 1
+				|| !(domainResults.get( 0 ) instanceof EntityResult<?> entityResult)
+				|| sqmQuerySpec.getFromClause().getRoots().size() != 1
+				|| sqmQuerySpec.getSelectClause().getSelections().size() != 1 ) {
+			return;
+		}
+		final var root = sqmQuerySpec.getFromClause().getRoots().get( 0 );
+		if ( root.isCorrelated() || root.hasTreats() || !root.getSqmJoins().isEmpty()
+				|| sqmQuerySpec.getSelectClause().getSelections().get( 0 ).getSelectableNode() != root
+				|| !root.getNavigablePath().equals( entityResult.getNavigablePath() ) ) {
+			return;
+		}
+		final var tableGroup = getFromClauseIndex().findTableGroup( root.getNavigablePath() );
+		if ( !tableGroup.getNestedTableGroupJoins().isEmpty()
+				|| !tableGroup.getTableReferenceJoins().isEmpty() ) {
+			return;
+		}
+
+		// Only implicit, owning to-one joins to a primary key are known to preserve
+		// the functional dependency on the selected root's complete identifier here.
+		final Set<String> qualifiers = new HashSet<>();
+		final Set<String> restrictedQualifiers = new HashSet<>();
+		final Set<ColumnReference> restrictedKeyColumns = new HashSet<>();
+		qualifiers.add( tableGroup.getPrimaryTableReference().getIdentificationVariable() );
+		for ( var join : tableGroup.getTableGroupJoins() ) {
+			final var joinedGroup = join.getJoinedGroup();
+			if ( !(joinedGroup.getModelPart() instanceof ToOneAttributeMapping toOne)
+					|| toOne.getSideNature() != ForeignKeyDescriptor.Nature.KEY
+					|| !toOne.isReferenceToPrimaryKey()
+					|| !joinedGroup.getTableGroupJoins().isEmpty()
+					|| !joinedGroup.getNestedTableGroupJoins().isEmpty() ) {
+				return;
+			}
+			if ( joinedGroup.isInitialized() ) {
+				if ( !joinedGroup.getTableReferenceJoins().isEmpty() ) {
+					return;
+				}
+				final String qualifier = joinedGroup.getPrimaryTableReference().getIdentificationVariable();
+				qualifiers.add( qualifier );
+				if ( toOne.hasWhereRestrictions() ) {
+					restrictedQualifiers.add( qualifier );
+					toOne.getForeignKeyDescriptor().getKeyPart().forEachSelectable( (index, selectable) ->
+							restrictedKeyColumns.add( new ColumnReference(
+									tableGroup.resolveTableReference(
+											root.getNavigablePath(), selectable.getContainingTableExpression() ),
+									selectable ) ) );
+					toOne.getAssociatedEntityMappingType().getIdentifierMapping().forEachSelectable( (index, selectable) ->
+							restrictedKeyColumns.add( new ColumnReference(
+									joinedGroup.resolveTableReference(
+											joinedGroup.getNavigablePath(), selectable.getContainingTableExpression() ),
+									selectable ) ) );
+				}
+			}
+		}
+		if ( restrictedQualifiers.isEmpty() ) {
+			return;
+		}
+		final Set<ColumnReference> groupedColumns = new HashSet<>();
+		for ( var expression : sqlQuerySpec.getGroupByClauseExpressions() ) {
+			if ( !collectGroupingColumns( expression, groupedColumns ) ) {
+				return;
+			}
+		}
+		final var identifierMapping = entityResult.getReferencedMappingContainer().getIdentifierMapping();
+		for ( int i = 0; i < identifierMapping.getJdbcTypeCount(); i++ ) {
+			final var selectable = identifierMapping.getSelectable( i );
+			if ( selectable.isFormula() || !groupedColumns.contains( new ColumnReference(
+					tableGroup.resolveTableReference( root.getNavigablePath(), selectable.getContainingTableExpression() ),
+					selectable ) ) ) {
+				return;
+			}
+		}
+		boolean hasRestrictedHydration = false;
+		final List<Expression> missingColumns = new ArrayList<>();
+		for ( var selection : sqlQuerySpec.getSelectClause().getSqlSelections() ) {
+			if ( !(selection.getExpression() instanceof ColumnReference column)
+					|| column.isColumnExpressionFormula() || column.getReadExpression() != null
+					|| !qualifiers.contains( column.getQualifier() ) ) {
+				return;
+			}
+			hasRestrictedHydration |= restrictedQualifiers.contains( column.getQualifier() );
+			if ( groupedColumns.add( column ) ) {
+				// Do not expand unrelated state, such as a JSON or LOB property that
+				// a dialect allows selecting by functional dependency but cannot group.
+				if ( !restrictedKeyColumns.contains( column ) ) {
+					return;
+				}
+				missingColumns.add( column );
+			}
+		}
+		if ( hasRestrictedHydration && !missingColumns.isEmpty() ) {
+			// Keep both the restricted query join and the hydration join. Their identifiers
+			// need not use the same alias, and hydration also needs the physical owner FK.
+			final List<Expression> groupBy = new ArrayList<>( sqlQuerySpec.getGroupByClauseExpressions() );
+			groupBy.addAll( missingColumns );
+			sqlQuerySpec.setGroupByClauseExpressions( groupBy );
+		}
+	}
+
+	private static boolean collectGroupingColumns(Expression expression, Set<ColumnReference> columns) {
+		if ( expression instanceof EntityValuedPathInterpretation<?> entityPath ) {
+			return collectGroupingColumns( entityPath.getSqlExpression(), columns );
+		}
+		if ( expression instanceof SqlSelectionExpression selectionExpression ) {
+			return collectGroupingColumns( selectionExpression.getSelection().getExpression(), columns );
+		}
+		final var tuple = SqlTupleContainer.getSqlTuple( expression );
+		if ( tuple != null ) {
+			for ( var tupleExpression : tuple.getExpressions() ) {
+				if ( !collectGroupingColumns( tupleExpression, columns ) ) {
+					return false;
+				}
+			}
+			return true;
+		}
+		final var column = expression.getColumnReference();
+		if ( column == null || column.isColumnExpressionFormula() || column.getReadExpression() != null ) {
+			return false;
+		}
+		columns.add( column );
+		return true;
+	}
