+package org.hibernate.temporal;
+
+import java.util.List;
+
+import jakarta.persistence.Entity;
+import jakarta.persistence.Id;
+
+import org.hibernate.SharedSessionContract;
+import org.hibernate.annotations.Temporal;
+import org.hibernate.temporal.spi.ChangesetIdentifierSupplier;
+import org.hibernate.testing.orm.junit.DomainModel;
+import org.hibernate.testing.orm.junit.JiraKey;
+import org.hibernate.testing.orm.junit.ServiceRegistry;
+import org.hibernate.testing.orm.junit.SessionFactory;
+import org.hibernate.testing.orm.junit.SessionFactoryScope;
+import org.hibernate.testing.orm.junit.Setting;
+import org.junit.jupiter.api.Test;
+
+import static org.hibernate.cfg.StateManagementSettings.CHANGESET_ID_SUPPLIER;
+import static org.hibernate.cfg.StateManagementSettings.TEMPORAL_TABLE_STRATEGY;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+@JiraKey("HHH-21276")
+@DomainModel(annotatedClasses = TemporalFlushThenRemoveTest.Item.class)
+@SessionFactory
+class TemporalFlushThenRemoveTest {
+	private static final String SUPPLIER = "org.hibernate.temporal.TemporalFlushThenRemoveTest$Sequence";
+
+	@Test
+	@ServiceRegistry(settings = {
+			@Setting(name = TEMPORAL_TABLE_STRATEGY, value = "SINGLE_TABLE"),
+			@Setting(name = CHANGESET_ID_SUPPLIER, value = SUPPLIER),
+			@Setting(name = "hibernate.flush.queue.type", value = "graph")
+	})
+	void updateFlushRemoveSingleTable(SessionFactoryScope scope) {
+		verifyHistoryAfterUpdate( scope );
+	}
+
+	@Test
+	@ServiceRegistry(settings = {
+			@Setting(name = TEMPORAL_TABLE_STRATEGY, value = "HISTORY_TABLE"),
+			@Setting(name = CHANGESET_ID_SUPPLIER, value = SUPPLIER),
+			@Setting(name = "hibernate.flush.queue.type", value = "graph")
+	})
+	void updateFlushRemoveHistoryTable(SessionFactoryScope scope) {
+		verifyHistoryAfterUpdate( scope );
+	}
+
+	@Test
+	@ServiceRegistry(settings = {
+			@Setting(name = TEMPORAL_TABLE_STRATEGY, value = "SINGLE_TABLE"),
+			@Setting(name = CHANGESET_ID_SUPPLIER, value = SUPPLIER),
+			@Setting(name = "hibernate.flush.queue.type", value = "graph")
+	})
+	void persistFlushRemoveSingleTable(SessionFactoryScope scope) {
+		verifyNoHistoryAfterInsert( scope );
+	}
+
+	@Test
+	@ServiceRegistry(settings = {
+			@Setting(name = TEMPORAL_TABLE_STRATEGY, value = "HISTORY_TABLE"),
+			@Setting(name = CHANGESET_ID_SUPPLIER, value = SUPPLIER),
+			@Setting(name = "hibernate.flush.queue.type", value = "graph")
+	})
+	void persistFlushRemoveHistoryTable(SessionFactoryScope scope) {
+		verifyNoHistoryAfterInsert( scope );
+	}
+
+	private static void verifyHistoryAfterUpdate(SessionFactoryScope scope) {
+		final var original = scope.fromTransaction( session -> {
+			session.persist( new Item( 1, "original" ) );
+			return session.getCurrentChangesetIdentifier();
+		} );
+		final var removal = scope.fromTransaction( session -> {
+			final var item = session.find( Item.class, 1 );
+			item.name = "new";
+			session.flush();
+			session.remove( item );
+			return session.getCurrentChangesetIdentifier();
+		} );
+		assertEquals( List.of( "original" ), namesAt( scope, original ) );
+		assertEquals( List.of(), namesAt( scope, removal ) );
+	}
+
+	private static void verifyNoHistoryAfterInsert(SessionFactoryScope scope) {
+		final var removal = scope.fromTransaction( session -> {
+			final var item = new Item( 1, "transient version" );
+			session.persist( item );
+			session.flush();
+			session.remove( item );
+			return session.getCurrentChangesetIdentifier();
+		} );
+		assertEquals( List.of(), namesAt( scope, removal ) );
+	}
+
+	private static List<String> namesAt(SessionFactoryScope scope, Object changeset) {
+		try (var session = scope.getSessionFactory().withOptions().atChangeset( changeset ).openSession()) {
+			return session.createSelectionQuery( "select i.name from FlushRemovalItem i order by i.id", String.class ).list();
+		}
+	}
+
+	public static class Sequence implements ChangesetIdentifierSupplier<Integer> {
+		private int next;
+
+		@Override
+		public Integer generateIdentifier(SharedSessionContract session) {
+			return ++next;
+		}
+	}
+
+	@Entity(name = "FlushRemovalItem")
+	@Temporal
+	static class Item {
+		@Id
+		int id;
+
+		String name;
+
+		Item() {
+		}
+
+		Item(int id, String name) {
+			this.id = id;
+			this.name = name;
+		}
+	}
+}
